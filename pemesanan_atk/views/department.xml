<odoo>
  <data>

    <record id="view_department_tree" model="ir.ui.view">
      <field name="name">pemesanan_atk.department.tree</field>
      <field name="model">pemesanan_atk.department</field>
      <field name="arch" type="xml">
        <tree>
          <field name="name"/>
        </tree>
      </field>
    </record>

    <record id="view_department_form" model="ir.ui.view">
      <field name="name">pemesanan_atk.department.form</field>
      <field name="model">pemesanan_atk.department</field>
      <field name="arch" type="xml">
        <form string="Departemen">
          <sheet>
            <group>
              <field name="name"/>
            </group>
          </sheet>
        </form>
      </field>
    </record>

    <record id="action_department" model="ir.actions.act_window">
      <field name="name">Departemen</field>
      <field name="res_model">pemesanan_atk.department</field>
      <field name="view_mode">tree,form</field>
      <field name="help" type="html">
        <p class="oe_view_nocontent_create">
          Klik tombol Create untuk menambahkan departemen.
        </p>
      </field>
    </record>

    <menuitem id="menu_master" name="Master" sequence="10" parent="menu_root"/>
    <menuitem id="menu_department" name="Departemen" parent="menu_master"
              action="action_department"/>

  </data>
</odoo>